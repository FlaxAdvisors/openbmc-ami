From a1b2c3d4e5f6a1b2c3d4e5f6a1b2c3d4e5f6a1b2 Mon Sep 17 00:00:00 2001
From: OpenBMC Build <openbmc@build>
Date: Wed, 19 Mar 2026 00:00:00 +0000
Subject: [PATCH] board: aspeed: tiogapass: enable VGA for KVM

Write SDRAM_VIDEO_UNLOCK_KEY (0x2003000f) to SDMC register 0x008
to unlock graphics memory access for KVM video capture. This is
the same value used by the AMI production firmware. Also enable
VGA MMIO (SCU 0x180 bit 1) for host PCIe VGA register access.

isolate_bmc() corrupts register 0x008 by writing protection bits;
this restores the correct video unlock key afterward.

Signed-off-by: OpenBMC Build <openbmc@build>
---
 board/aspeed/evb_ast2500/tiogapass.c | 14 ++++++++++++++
 1 file changed, 14 insertions(+)

--- a/board/aspeed/evb_ast2500/tiogapass.c
+++ b/board/aspeed/evb_ast2500/tiogapass.c
@@ -392,6 +392,20 @@
     *((volatile ulong *) (0x1e789094)) = 0xFFEFFFD5;                                                           \
     /*--- end of SuperIO UART1 config ---*/                                                                     \
                                                                                                            		\
+    /*--- Enable VGA for KVM video capture ---*/                                                                \
+    {                                                                                                           \
+        volatile ulong *scu_pcie = (volatile ulong *)0x1e6e2180;                                                \
+        *scu_pcie = *scu_pcie | (1 << 1);  /* set VGA_MMIO bit */                                               \
+    }                                                                                                           \
+    {                                                                                                           \
+        volatile ulong *sdmc_prot = (volatile ulong *)0x1e6e0000;                                               \
+        volatile ulong *sdmc_gfx  = (volatile ulong *)0x1e6e0008;                                               \
+        *sdmc_prot = 0xfc600309;  /* unlock SDMC registers */                                                   \
+        *sdmc_gfx  = 0x2003000f;  /* SDRAM_VIDEO_UNLOCK_KEY: unlock graphics memory */                          \
+        *sdmc_prot = 0;           /* re-lock SDMC registers */                                                  \
+    }                                                                                                           \
+    /*--- end of VGA KVM config ---*/                                                                           \
+                                                                                                           		\
 	/* config simple GPIO 0 data and direction */                                                        		\
 	*(volatile ulong *) (GPIO_REG_BASE + GPIOIJKL_OFFSET + GPIO_DAT) |= 0x20000004;  /* Data: GPIOLKJI */ 		\
 	*(volatile ulong *) (GPIO_REG_BASE + GPIOIJKL_OFFSET + GPIO_DIR) |= 0x2000000C;  /* Dir : GPIOLKJI */ 		\
