[Unit]
Description=BMC<->host virtual NIC (USB CDC-ECM gadget) for in-band Redfish
ConditionPathIsMountPoint=/sys/kernel/config
After=phosphor-ipmi-host.service
Wants=network.target
Before=network.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/create_usbeth.sh connect
ExecStop=/usr/bin/create_usbeth.sh disconnect

[Install]
WantedBy=multi-user.target
