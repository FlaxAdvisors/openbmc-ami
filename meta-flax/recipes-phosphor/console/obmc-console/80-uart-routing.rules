# TiogaPass SOL uses UART4 (ttyS3) via direct LPC COM1 (0x2F8) hardware decode (HICRC).
# No UART crossbar routing needed: COM1->UART4 is pure LPC hardware decode, set in U-Boot.
# The old crossbar rule (uart2 <- uart1 for ttyS1) is intentionally removed because
# UART2 TX echo -> UART1 RX -> host COM0 RX caused BIOS keyboard noise (spurious ESC/H).

# Tag ttyS3 so systemd creates a device unit (dev-ttyS3.device) for it.
SUBSYSTEM=="tty", KERNEL=="ttyS3", TAG+="systemd"
