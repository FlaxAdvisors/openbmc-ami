# Route ASPEED UART crossbar: uart1 (LPC COM1/0x3F8) <-> uart3 (ttyS2/BMC SOL)
# Also route uart4 <-> io1 for the SoL BMC side.
# This fires when the uart_routing platform driver binds, before services start.
# ROUTER path matches sol-configure.sh: /sys/bus/platform/drivers/aspeed-uart-routing/*.uart-routing
ACTION=="add", SUBSYSTEM=="platform", DRIVER=="aspeed-uart-routing", \
    RUN+="/bin/sh -c 'R=/sys/bus/platform/drivers/aspeed-uart-routing/%k; echo uart3 > $R/uart1; echo uart1 > $R/uart3; echo io1 > $R/uart4; echo uart4 > $R/io1'"

# Tag ttyS2 so systemd creates a device unit (dev-ttyS2.device) for it.
# Standard platform UARTs don't generate hotplug events by default.
SUBSYSTEM=="tty", KERNEL=="ttyS2", TAG+="systemd"
