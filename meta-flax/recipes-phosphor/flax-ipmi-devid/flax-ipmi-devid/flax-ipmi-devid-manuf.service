[Unit]
Description=Derive IPMI Get Device ID manufacturer from board FRU
Wants=xyz.openbmc_project.FruDevice.service
After=xyz.openbmc_project.FruDevice.service
# Cache the value before the IPMI stack first answers Get Device ID.
Before=phosphor-ipmi-host.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/flax-ipmi-devid-manuf.sh

[Install]
WantedBy=multi-user.target
