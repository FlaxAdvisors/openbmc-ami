+                  </dl>
+                </b-col>
+              </b-row>
             </b-container>
           </template>
 
@@ -337,6 +351,8 @@
   data() {
     return {
       isBusy: true,
+      // Per-entry AdditionalData attachment content, fetched lazily on expand
+      additionalDataMap: {},
       fields: [
         {
           key: 'expandRow',
@@ -509,6 +525,22 @@
     });
   },
   methods: {
+    // Expand/collapse a row and, on expand, lazily fetch its AdditionalData
+    // attachment so the detail (e.g. failing SYSTEMD_UNIT) is shown inline.
+    async toggleRowDetailsWithData(row) {
+      this.toggleRowDetails(row);
+      if (
+        row.detailsShowing &&
+        row.item.additionalDataUri &&
+        !this.additionalDataMap[row.item.id]
+      ) {
+        const data = await this.$store.dispatch(
+          'eventLog/getEntryAdditionalData',
+          row.item.additionalDataUri,
+        );
+        if (data) this.$set(this.additionalDataMap, row.item.id, data);
+      }
+    },
     downloadEntry(uri) {
       let filename = uri?.split('LogServices/')?.[1].concat('.log');
       filename.replace(RegExp('/', 'g'), '_');
