From: FlaxAdvisors
Subject: Fix crash in chassishandler.cpp when power restore settings absent

Two bugs when the settings service is unavailable:

1. getPowerRestorePolicy(): the catch block calls map::at() again while
   handling the map::at() exception from the try block. This throws a
   second exception during stack unwinding -> program terminates (SEGV
   signal 11).

2. setPowerRestorePolicy(): map::at() throws std::out_of_range which is
   not caught by the catch (InternalFailure) handler -> propagates up
   uncaught.

--- a/chassishandler.cpp
+++ b/chassishandler.cpp
@@ -951,10 +951,15 @@
     }
     catch (const std::exception& e)
     {
-        lg2::error(
-            "Failed to fetch pgood property ({PATH}/{INTERFACE}): {ERROR}",
-            "PATH", objects.map.at(powerRestoreIntf).front(), "INTERFACE",
-            powerRestoreIntf, "ERROR", e);
+        auto pathIt = objects.map.find(powerRestoreIntf);
+        const std::string pathStr =
+            (pathIt != objects.map.end() && !pathIt->second.empty())
+                ? std::string(pathIt->second.front())
+                : std::string("(not found)");
+        lg2::error(
+            "Failed to fetch pgood property ({PATH}/{INTERFACE}): {ERROR}",
+            "PATH", pathStr, "INTERFACE",
+            powerRestoreIntf, "ERROR", e);
         cache::objectsPtr.reset();
         return std::nullopt;
     }
@@ -2873,8 +2878,14 @@
     try
     {
         settings::Objects& objects = chassis::internal::cache::getObjects();
-        const settings::Path& powerRestoreSetting =
-            objects.map.at(chassis::internal::powerRestoreIntf).front();
+        auto mapIt = objects.map.find(chassis::internal::powerRestoreIntf);
+        if (mapIt == objects.map.end() || mapIt->second.empty())
+        {
+            lg2::error("Power restore policy setting not available");
+            chassis::internal::cache::objectsPtr.reset();
+            return ipmi::responseUnspecifiedError();
+        }
+        const settings::Path& powerRestoreSetting = mapIt->second.front();
         std::variant<std::string> property = convertForMessage(value);

         auto sdbusp = getSdBus();
