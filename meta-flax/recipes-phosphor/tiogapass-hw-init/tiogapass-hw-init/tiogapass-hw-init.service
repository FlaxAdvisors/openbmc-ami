[Unit]
Description=TiogaPass hardware initialization (GPIO setup, LPC port 80h redirect)
DefaultDependencies=no
After=systemd-udevd.service phosphor-ipmi-kcs@ipmi_kcs3.service
Before=multi-user.target

[Service]
Type=oneshot
ExecStart=/usr/bin/tiogapass-hw-init.sh
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
