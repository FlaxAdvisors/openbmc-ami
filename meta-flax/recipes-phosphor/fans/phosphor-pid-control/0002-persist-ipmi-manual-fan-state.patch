+/*
+ * Put back any manual fan state set over IPMI before this zone set was built
+ * (BMC reboot, swampd restart, or an in-process rebuild on a configuration
+ * change).  See ipmi/manual_persist.hpp.  Runs before the zones' control loops
+ * start, so the PID loop never gets a cycle on a zone that was left manual.
+ */
+static void restoreManualState()
+{
+    static constexpr auto pwmObjectPath =
+        "/xyz/openbmc_project/control/fanpwm/Pwm_";
+    static constexpr auto pwmBusName = "xyz.openbmc_project.FanSensor";
+    static constexpr auto pwmIntf = "xyz.openbmc_project.Control.FanPwm";
+
+    for (const auto& [id, zone] : state::zones)
+    {
+        auto duties = manual_persist::load(id);
+        if (!duties)
+        {
+            continue;
+        }
+
+        auto dbusZone = std::dynamic_pointer_cast<DbusPidZone>(zone);
+        if (!dbusZone)
+        {
+            continue;
+        }
+
+        /* Sets both the loop's flag and the Control.Mode Manual property. */
+        dbusZone->manual(true);
+        std::cerr << "zone " << id << ": restored manual mode\n";
+
+        auto bus = sdbusplus::bus::new_system();
+        for (const auto& [fan, duty] : *duties)
+        {
+            std::string path = pwmObjectPath + std::to_string(fan);
+            try
+            {
+                auto msg = bus.new_method_call(
+                    pwmBusName, path.c_str(),
+                    "org.freedesktop.DBus.Properties", "Set");
+                msg.append(pwmIntf, "Target",
+                           std::variant<uint64_t>(static_cast<uint64_t>(duty)));
+                bus.call_noreply(msg);
+                std::cerr << "zone " << id << ": restored Pwm_"
+                          << static_cast<unsigned int>(fan) << " duty "
+                          << static_cast<unsigned int>(duty) << "\n";
+            }
+            catch (const std::exception& e)
+            {
+                std::cerr << "zone " << id << ": failed to restore Pwm_"
+                          << static_cast<unsigned int>(fan) << ": " << e.what()
+                          << "\n";
+            }
+        }
+    }
+}
+
 void restartControlLoops()
 {
     stopControlLoops();
