--- /dev/null
+++ b/ipmi/manual_persist.hpp
@@ -0,0 +1,95 @@
+#pragma once
+
+/*
+ * Manual fan state set over IPMI, kept on /var so that it survives a BMC
+ * reboot and a swampd restart.  /var is the rwfs overlay, so a factory reset
+ * wipes it and the fans come back under PID control.
+ *
+ * One file per zone.  The file existing means the zone is in manual mode;
+ * each line inside is "<pwm index> <raw duty 0-255>" for an output that was
+ * given a duty while the zone was manual.  The IPMI handler (ipmid) writes
+ * it, swampd reads it each time it builds its zones.
+ *
+ * Header-only: it is compiled into both libmanualcmds and swampd.
+ */
+
+#include <cstdint>
+#include <filesystem>
+#include <fstream>
+#include <map>
+#include <optional>
+#include <string>
+#include <system_error>
+
+namespace pid_control
+{
+namespace manual_persist
+{
+
+/* pwm index -> raw duty */
+using Duties = std::map<uint8_t, uint8_t>;
+
+inline const std::filesystem::path stateDir = "/var/lib/phosphor-pid-control";
+
+inline std::filesystem::path zoneFile(int64_t zone)
+{
+    return stateDir / ("manual-zone" + std::to_string(zone));
+}
+
+/* Returns nothing when the zone was not left in manual mode. */
+inline std::optional<Duties> load(int64_t zone)
+{
+    std::ifstream in(zoneFile(zone));
+    if (!in)
+    {
+        return std::nullopt;
+    }
+
+    Duties duties;
+    unsigned int fan, duty;
+    while (in >> fan >> duty)
+    {
+        if (fan > 0 && fan <= 0xff && duty <= 0xff)
+        {
+            duties[static_cast<uint8_t>(fan)] = static_cast<uint8_t>(duty);
+        }
+    }
+    return duties;
+}
+
+/* Written to a temporary and renamed so a power loss never leaves half a
+ * file.  Returns false if the state could not be stored. */
+inline bool save(int64_t zone, const Duties& duties)
+{
+    std::error_code ec;
+    std::filesystem::create_directories(stateDir, ec);
+
+    auto path = zoneFile(zone);
+    auto tmp = path;
+    tmp += ".tmp";
+    {
+        std::ofstream out(tmp, std::ios::trunc);
+        for (const auto& [fan, duty] : duties)
+        {
+            out << static_cast<unsigned int>(fan) << ' '
+                << static_cast<unsigned int>(duty) << '\n';
+        }
+        out.flush();
+        if (!out)
+        {
+            std::filesystem::remove(tmp, ec);
+            return false;
+        }
+    }
+    std::filesystem::rename(tmp, path, ec);
+    return !ec;
+}
+
+inline void clear(int64_t zone)
+{
+    std::error_code ec;
+    std::filesystem::remove(zoneFile(zone), ec);
+}
+
+} // namespace manual_persist
+} // namespace pid_control
