#!/bin/bash
# TiogaPass BIOS firmware update script
# Invoked by obmc-flash-host-bios@<version>.service when phosphor-software-manager
# processes an image with purpose=VersionPurpose.Host.
#
# Argument: /tmp/images/<version-id>  (directory containing image-bios)
#
# The BIOS SPI flash is on 1e630000.spi (spi1, flash@0, label="pnor").
# It is shared between the BMC and the PCH: GPIO N5 (BIOS_SPI_BMC_CTRL)
# switches the mux — high = BMC owns the bus, low (input) = PCH owns it.
#
# At BMC boot the mux is at PCH, so JEDEC probe of spi1.0 reads all-zeros
# and the spi-nor driver does not bind.  The correct sequence is:
#   1. Switch mux to BMC (GPIO high)
#   2. Unbind spi-aspeed-smc from 1e630000.spi (removes spi1.0 child device)
#   3. Rebind  spi-aspeed-smc to 1e630000.spi (re-probes flash; JEDEC succeeds)
#   4. Wait for pnor MTD to appear, then flashcp
#   5. Unbind controller, switch mux back to PCH, leave driver unbound
#
# A bash EXIT trap guarantees the SPI bus is returned to PCH even on error.

set -e

IMAGE_DIR="${1}"
IMAGE_FILE="${IMAGE_DIR}/image-bios"

# GPIO N5 = BIOS_SPI_BMC_CTRL (offset 109 from chip base)
# AST2500 has one gpiochip; find its base dynamically.
GPIO_BASE=$(sort -n /sys/class/gpio/gpiochip*/base 2>/dev/null | head -n 1)
if [ -z "${GPIO_BASE}" ]; then
    echo "bios-update: error: cannot determine GPIO chip base"
    exit 1
fi
# N5: bank N = 13, bit 5 → offset = 13*8 + 5 = 109
GPIO_SPI_MUX=$(( GPIO_BASE + 109 ))

SPI_DRIVER="spi-aspeed-smc"
SPI_DEV="1e630000.spi"
SPI_PATH="/sys/bus/platform/drivers/${SPI_DRIVER}"

# ── helpers ──────────────────────────────────────────────────────────────────

spi_mux_to_bmc() {
    echo "bios-update: switching SPI mux to BMC (GPIO ${GPIO_SPI_MUX})"
    if [ ! -d /sys/class/gpio/gpio${GPIO_SPI_MUX} ]; then
        echo ${GPIO_SPI_MUX} > /sys/class/gpio/export
    fi
    echo out > /sys/class/gpio/gpio${GPIO_SPI_MUX}/direction
    echo 1   > /sys/class/gpio/gpio${GPIO_SPI_MUX}/value
}

spi_mux_to_pch() {
    echo "bios-update: switching SPI mux back to PCH (GPIO ${GPIO_SPI_MUX})"
    if [ -d /sys/class/gpio/gpio${GPIO_SPI_MUX} ]; then
        echo 0   > /sys/class/gpio/gpio${GPIO_SPI_MUX}/value
        echo in  > /sys/class/gpio/gpio${GPIO_SPI_MUX}/direction
        echo ${GPIO_SPI_MUX} > /sys/class/gpio/unexport
    fi
}

spi_unbind() {
    if [ -e "${SPI_PATH}/${SPI_DEV}" ]; then
        echo "bios-update: unbinding ${SPI_DRIVER} from ${SPI_DEV}"
        echo -n "${SPI_DEV}" > "${SPI_PATH}/unbind"
        sleep 1
    fi
}

spi_bind() {
    echo "bios-update: binding ${SPI_DRIVER} to ${SPI_DEV}"
    echo -n "${SPI_DEV}" > "${SPI_PATH}/bind"
    sleep 2
}

find_pnor_dev() {
    for mtddev in /sys/class/mtd/mtd*/name; do
        if [ "$(cat "${mtddev}" 2>/dev/null)" = "pnor" ]; then
            local mtdname
            mtdname=$(basename "$(dirname "${mtddev}")")
            echo "/dev/${mtdname}"
            return 0
        fi
    done
    return 1
}

# ── systemd watchdog guard ───────────────────────────────────────────────────
# A full BIOS flashcp takes ~4 min and hammers the AHB bus enough to starve
# systemd (PID1), so the aspeed hardware watchdog (RuntimeWatchdogUSec, default
# 2 min, pretimeout=panic) fires and RESETS THE BMC mid-write — leaving a
# half-written, corrupt host BIOS.  Disarm it for the duration of the flash and
# always re-arm it afterwards (including via the cleanup trap on any failure).

WDT_MGR="org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager"
_wdt_disarmed=0
_wdt_saved=""

wdt_disarm() {
    _wdt_saved=$(busctl get-property ${WDT_MGR} RuntimeWatchdogUSec 2>/dev/null | awk '{print $2}')
    case "${_wdt_saved}" in ''|0) _wdt_saved=120000000 ;; esac
    echo "bios-update: disarming systemd watchdog (was ${_wdt_saved} us) for the flash"
    if busctl set-property ${WDT_MGR} RuntimeWatchdogUSec t 0 2>/dev/null; then
        _wdt_disarmed=1
    else
        echo "bios-update: warning: could not disarm systemd watchdog (continuing)"
    fi
}

wdt_rearm() {
    if [ "${_wdt_disarmed}" = "1" ]; then
        echo "bios-update: re-arming systemd watchdog (${_wdt_saved} us)"
        busctl set-property ${WDT_MGR} RuntimeWatchdogUSec t "${_wdt_saved}" 2>/dev/null \
            || echo "bios-update: warning: could not re-arm systemd watchdog"
        _wdt_disarmed=0
    fi
}

# ── cleanup trap ──────────────────────────────────────────────────────────────
# Runs on any exit (success or failure) — ensures SPI bus returns to PCH.

_cleanup_done=0
cleanup() {
    if [ "${_cleanup_done}" = "0" ]; then
        _cleanup_done=1
        spi_unbind 2>/dev/null || true
        spi_mux_to_pch 2>/dev/null || true
    fi
    # Always restore the watchdog, even on a failed/partial flash (idempotent).
    wdt_rearm 2>/dev/null || true
}
trap cleanup EXIT

# ── pre-flight ────────────────────────────────────────────────────────────────

if [ -z "${IMAGE_DIR}" ]; then
    echo "bios-update: error: no image directory argument"
    exit 1
fi

if [ ! -f "${IMAGE_FILE}" ]; then
    echo "bios-update: error: image not found: ${IMAGE_FILE} (tar must contain 'image-bios')"
    exit 1
fi

echo "bios-update: BIOS update started at $(date)"
echo "bios-update: image: ${IMAGE_FILE} ($(du -h "${IMAGE_FILE}" | cut -f1))"

# ── power off host ────────────────────────────────────────────────────────────

echo "bios-update: powering off host"
obmcutil poweroff
# wait up to 60s for host to reach Off state
for i in $(seq 1 12); do
    sleep 5
    STATE=$(busctl get-property xyz.openbmc_project.State.Host \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host CurrentHostState 2>/dev/null | awk '{print $2}' | tr -d '"')
    echo "bios-update: host state: ${STATE}"
    case "${STATE}" in
        *Off*|*Standby*)
            break
            ;;
    esac
    if [ "${i}" -eq 12 ]; then
        echo "bios-update: error: host did not power off after 60s"
        exit 1
    fi
done

# ── take the SPI bus ──────────────────────────────────────────────────────────
# Switch mux FIRST so that when the driver rebinds, the JEDEC probe succeeds.

spi_mux_to_bmc
sleep 1
spi_unbind
spi_bind

# ── find pnor MTD ─────────────────────────────────────────────────────────────
# After rebind the spi-nor driver will probe spi1.0 and create a pnor MTD.
# Retry a few times in case the MTD registration is slightly delayed.

PNOR_DEV=""
for i in $(seq 1 5); do
    PNOR_DEV=$(find_pnor_dev) && break || true
    echo "bios-update: waiting for pnor MTD (attempt ${i}/5)..."
    sleep 2
done

if [ -z "${PNOR_DEV}" ]; then
    echo "bios-update: error: pnor MTD partition not found after driver bind"
    exit 1
fi

echo "bios-update: flashing ${IMAGE_FILE} → ${PNOR_DEV}"

# ── flash ─────────────────────────────────────────────────────────────────────
# Disarm the watchdog only around the long write, then re-arm immediately so the
# BMC is unprotected for the shortest possible window.

wdt_disarm
flashcp -v "${IMAGE_FILE}" "${PNOR_DEV}"
wdt_rearm

echo "bios-update: flash complete"

# ── release the SPI bus ───────────────────────────────────────────────────────
# Unbind and return bus to PCH before powering on host.
# The cleanup trap will also run on exit but this makes the log clearer.

_cleanup_done=1
spi_unbind
sleep 2
spi_mux_to_pch
sleep 2

# ── power on host ─────────────────────────────────────────────────────────────
# Use obmcutil to drive x86-power-control's normal power-on path
# (xyz.openbmc_project.Chassis.Control.Power@0).  Fighting power-control
# for the power-button GPIO directly never worked — it owns those lines
# for the lifetime of the service.

echo "bios-update: powering on host (obmcutil poweron)"
obmcutil poweron || true

# Poll up to 60s for the host to leave Off.  power-control may still report
# "power supply power good failed to assert" if the PSU does not respond;
# in that case the user must AC-cycle the chassis to clear PSU state.
STATE="unknown"
for _i in $(seq 1 12); do
    sleep 5
    STATE=$(busctl get-property xyz.openbmc_project.State.Host \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host CurrentHostState 2>/dev/null \
        | awk '{print $2}' | tr -d '"')
    case "${STATE}" in
        *Off*) ;;
        *) break ;;
    esac
done
echo "bios-update: host state after power-on: ${STATE:-unknown}"

echo "bios-update: done at $(date)"
exit 0
