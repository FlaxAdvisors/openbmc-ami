#!/bin/bash
# TiogaPass BIOS firmware update script
# Invoked by obmc-flash-host-bios@<version>.service when phosphor-software-manager
# processes an image with purpose=VersionPurpose.Host.
#
# Argument: /tmp/images/<version-id>  (directory containing image-bios)
#
# The BIOS SPI flash is on 1e630000.spi (spi1, flash@0, label="pnor").
# It is shared between the BMC and the PCH: GPIO N5 (BIOS_SPI_BMC_CTRL)
# switches the mux — high = BMC owns the bus, low (input) = PCH owns it.
#
# At BMC boot the mux is at PCH, so JEDEC probe of spi1.0 reads all-zeros
# and the spi-nor driver does not bind.  The correct sequence is:
#   1. Switch mux to BMC (GPIO high)
#   2. Unbind spi-aspeed-smc from 1e630000.spi (removes spi1.0 child device)
#   3. Rebind  spi-aspeed-smc to 1e630000.spi (re-probes flash; JEDEC succeeds)
#   4. Wait for pnor MTD to appear, then flashcp
#   5. Unbind controller, switch mux back to PCH, leave driver unbound
#
# A bash EXIT trap guarantees the SPI bus is returned to PCH even on error.
#
# The chip is a full Intel SPI image -- descriptor + ME + (GbE) + BIOS -- not
# just the BIOS region.  Rewriting the ME region puts the PCH in a state where
# it will not enter S0 until input power has actually been removed (G3): the
# host will not power on, and neither will the front-panel button, because that
# button is a hardware path into the PCH/CPLD, not something the BMC drives.
#
# So we flash with `flashcp -p`, which erases and writes only the eraseblocks
# that differ.  A same-ME BIOS update then never touches the ~16 MB ME region
# and needs no power cycle at all; a new/blank chip differs everywhere and is
# written in full, as it must be.  We compare the ME region against the chip
# before flashing so we know which case this is, and cycle the node through the
# hot-swap controller afterwards only when the ME actually changed.
#
# That comparison alone is not enough in practice.  The ME rewrites its own MFS
# while it runs -- on standby power, not just while the host is up -- so on any
# box that has ever booted, the chip's ME region has drifted from the pristine
# copy in the image and `flashcp -p` rewrites it.  Measured on 172.17.6.101
# 2026-09-22: a BIOS-only change still showed the ME as DIFFERS and locked the
# node out; the hot-swap cycle that was supposed to recover it silently did
# nothing on that board, so it took a physical reseat.  The "same-ME update
# skips the ME" case therefore never actually fires in the field.
#
# The fix is to stop asking the ME to be identical and simply not touch it: we
# splice the *chip's current* ME region into a scratch copy of the image and
# flash that.  flashcp -p then finds zero differing eraseblocks in the ME, so
# the region is never rewritten, no G3 is needed, and every block that IS
# written still gets flashcp's read-back verification.  A genuinely new ME can
# still be written on purpose with BIOS_UPDATE_WRITE_ME=1.  If anything about
# the splice fails we fall back to flashing the image as-is and cycling the
# node -- the old behaviour, which is safe but expensive.

set -e

IMAGE_DIR="${1}"
IMAGE_FILE="${IMAGE_DIR}/image-bios"

# Optional operator overrides.
#   BIOS_UPDATE_AUTO_POWER_CYCLE=0  -- never cycle the node automatically; print
#                                      the recovery command and leave it to the
#                                      operator.  Default is 1 (cycle).
#   BIOS_UPDATE_CYCLE_DELAY_S=<n>   -- seconds to wait before the cycle, so that
#                                      systemd can mark this unit "done" and
#                                      phosphor-software-manager can record the
#                                      new BIOS version first.  Default 20.
#   BIOS_UPDATE_WRITE_ME=1          -- actually write the image's ME region
#                                      instead of preserving the chip's.  Only
#                                      for an image that carries a genuinely new
#                                      ME; costs a G3.  Default 0 (preserve).
# shellcheck disable=SC1091
[ -r /etc/default/bios-update ] && . /etc/default/bios-update
AUTO_POWER_CYCLE="${BIOS_UPDATE_AUTO_POWER_CYCLE:-1}"
CYCLE_DELAY_S="${BIOS_UPDATE_CYCLE_DELAY_S:-20}"
WRITE_ME="${BIOS_UPDATE_WRITE_ME:-0}"

# ADM1275 hot-swap controller.  PMBus SEND BYTE of command 0xd9 makes it drop
# and restore its own output = a real G3 for the whole node, which is what
# clears the post-ME-flash lockout.  FB's power-util does the same for
# sled_cycle on this board: `i2cset -y 7 0x45 0xd9 c`.  That trailing `c` is
# i2cset's MODE (send byte, no data), NOT a value -- writing a data byte
# (`0xd9 0x0c`) is rejected with a CML error and cycles nothing.  -f is
# required because the adm1275 driver is bound.
HSC_BUS=7
HSC_ADDR=0x45
HSC_REG=0xd9
HSC_MODE=c

# GPIO N5 = BIOS_SPI_BMC_CTRL (offset 109 from chip base)
# AST2500 has one gpiochip; find its base dynamically.
GPIO_BASE=$(sort -n /sys/class/gpio/gpiochip*/base 2>/dev/null | head -n 1)
if [ -z "${GPIO_BASE}" ]; then
    echo "bios-update: error: cannot determine GPIO chip base"
    exit 1
fi
# N5: bank N = 13, bit 5 → offset = 13*8 + 5 = 109
GPIO_SPI_MUX=$(( GPIO_BASE + 109 ))

SPI_DRIVER="spi-aspeed-smc"
SPI_DEV="1e630000.spi"
SPI_PATH="/sys/bus/platform/drivers/${SPI_DRIVER}"

# ── helpers ──────────────────────────────────────────────────────────────────

spi_mux_to_bmc() {
    echo "bios-update: switching SPI mux to BMC (GPIO ${GPIO_SPI_MUX})"
    if [ ! -d /sys/class/gpio/gpio${GPIO_SPI_MUX} ]; then
        echo ${GPIO_SPI_MUX} > /sys/class/gpio/export
    fi
    echo out > /sys/class/gpio/gpio${GPIO_SPI_MUX}/direction
    echo 1   > /sys/class/gpio/gpio${GPIO_SPI_MUX}/value
}

spi_mux_to_pch() {
    echo "bios-update: switching SPI mux back to PCH (GPIO ${GPIO_SPI_MUX})"
    if [ -d /sys/class/gpio/gpio${GPIO_SPI_MUX} ]; then
        echo 0   > /sys/class/gpio/gpio${GPIO_SPI_MUX}/value
        echo in  > /sys/class/gpio/gpio${GPIO_SPI_MUX}/direction
        echo ${GPIO_SPI_MUX} > /sys/class/gpio/unexport
    fi
}

spi_unbind() {
    if [ -e "${SPI_PATH}/${SPI_DEV}" ]; then
        echo "bios-update: unbinding ${SPI_DRIVER} from ${SPI_DEV}"
        echo -n "${SPI_DEV}" > "${SPI_PATH}/unbind"
        sleep 1
    fi
}

spi_bind() {
    echo "bios-update: binding ${SPI_DRIVER} to ${SPI_DEV}"
    echo -n "${SPI_DEV}" > "${SPI_PATH}/bind"
    sleep 2
}

find_pnor_dev() {
    for mtddev in /sys/class/mtd/mtd*/name; do
        if [ "$(cat "${mtddev}" 2>/dev/null)" = "pnor" ]; then
            local mtdname
            mtdname=$(basename "$(dirname "${mtddev}")")
            echo "/dev/${mtdname}"
            return 0
        fi
    done
    return 1
}

# ── Intel ME region detection ────────────────────────────────────────────────
# The descriptor lives at the start of the chip: signature 0x0FF0A55A at 0x10,
# FLMAP0 at 0x14 carries FRBA (the region-base address), and FLREG2 at FRBA+8
# describes the ME region.  base/limit are 4 KiB-granular, encoded as bits
# [14:0] << 12 and bits [30:16] << 12 | 0xfff respectively.
#
# BusyBox od has no -A/-t.  `od -x` prints 16-bit words in host byte order, so
# on this (little-endian) BMC four bytes b0..b3 come out as two words "b1b0 b3b2"
# — the 32-bit LE value is therefore the second word followed by the first.
# If that ever stopped holding, the descriptor signature check in me_region()
# below would fail and we would fall back to "ME assumed changed", which is the
# safe direction.

read_u32le() {          # $1 = file, $2 = byte offset -> decimal value on stdout
    local hex
    hex=$(dd if="${1}" bs=1 skip="${2}" count=4 2>/dev/null | od -x | head -n 1 \
          | awk '{print $2 $3}')
    [ "${#hex}" -eq 8 ] || return 1
    printf '%u' "$(( 0x${hex:4:4}${hex:0:4} ))"
}

me_region() {           # $1 = image -> "<base> <length>" in bytes on stdout
    flreg_region "${1}" 8
}

# FLREG1 (BIOS) lives at FRBA+4, FLREG2 (ME) at FRBA+8 — same encoding.
bios_region() {         # $1 = image -> "<base> <length>" in bytes on stdout
    flreg_region "${1}" 4
}

flreg_region() {        # $1 = image, $2 = FLREG byte offset from FRBA
    local f="${1}" off="${2}" sig flmap0 frba flreg base limit
    sig=$(read_u32le "${f}" 16) || return 1
    [ "${sig}" -eq $(( 0x0FF0A55A )) ] || return 1
    flmap0=$(read_u32le "${f}" 20) || return 1
    frba=$(( ((flmap0 >> 16) & 0xff) << 4 ))
    flreg=$(read_u32le "${f}" $(( frba + off ))) || return 1
    base=$(( (flreg & 0x7fff) << 12 ))
    limit=$(( (((flreg >> 16) & 0x7fff) << 12) | 0xfff ))
    [ "${base}" -lt "${limit}" ] || return 1    # region marked unused
    echo "${base} $(( limit - base + 1 ))"
}

# "changed" | "unchanged".  Anything we cannot read confidently is reported as
# "changed", so an unrecognised image errs towards cycling the node rather than
# towards leaving the operator with a box that will not power on.
ME_STATE="changed"

detect_me_change() {
    local region base len blk cnt
    if ! region=$(me_region "${IMAGE_FILE}"); then
        echo "bios-update: no usable Intel flash descriptor in the image —" \
             "assuming the ME region changes"
        ME_STATE="changed"
        return 0
    fi
    base="${region% *}"
    len="${region#* }"
    if [ $(( base % 4096 )) -ne 0 ] || [ $(( len % 4096 )) -ne 0 ]; then
        echo "bios-update: ME region is not 4 KiB-aligned — assuming it changes"
        ME_STATE="changed"
        return 0
    fi
    blk=$(( base / 4096 ))
    cnt=$(( len / 4096 ))
    printf 'bios-update: ME region 0x%08x-0x%08x (%s KiB); comparing with the chip\n' \
        "${base}" "$(( base + len - 1 ))" "$(( len / 1024 ))"
    if dd if="${IMAGE_FILE}" bs=4096 skip="${blk}" count="${cnt}" 2>/dev/null \
       | cmp -s - <(dd if="${PNOR_DEV}" bs=4096 skip="${blk}" count="${cnt}" 2>/dev/null)
    then
        ME_STATE="unchanged"
        echo "bios-update: ME region is unchanged — flashcp -p will not touch it," \
             "no power cycle needed"
    else
        ME_STATE="changed"
        echo "bios-update: ME region DIFFERS from the chip"
    fi
}

# ── preserve everything below the BIOS region ────────────────────────────────
# A BIOS update only needs to write the BIOS region.  Everything below it on
# this chip -- descriptor, GbE, ME, Region5 and the unassigned span above the ME
# -- belongs to the platform and drifts at runtime, so writing it back from the
# image is both unnecessary and what triggers the PCH's G3 demand.
#
# Restricting this to the ME region alone is not enough: measured against a real
# chip dump, four eraseblocks OUTSIDE the descriptor's ME region (Region5 at
# 0xa30000-0xa50000 and 0xff0000) had also drifted.  Preserving only the ME
# would rewrite those while reporting "no cycle needed".
#
# So: copy the image, overwrite everything below the BIOS region in that copy
# with what the chip currently holds, and flash the copy.  flashcp -p then
# writes BIOS-region blocks only.
#
# Guards, all of which fall back to flashing the image as-is and cycling:
#   - the chip must already carry a valid descriptor whose BIOS region matches
#     the image's, otherwise we would be mixing two different layouts (and a
#     blank/new chip legitimately needs the whole image written);
#   - the copy is verified against the chip before it is accepted, because a
#     half-spliced image would rewrite the ME *and* report that it had not.

ME_PRESERVED_FILE=""

preserve_chip_me() {
    local region base len blk cnt tmp avail_kb need_kb chip_region

    if ! region=$(bios_region "${IMAGE_FILE}"); then
        echo "bios-update: cannot locate the BIOS region in the image —" \
             "flashing it as-is"
        return 1
    fi
    if ! chip_region=$(bios_region "${PNOR_DEV}"); then
        echo "bios-update: the chip has no usable descriptor (blank or new?) —" \
             "flashing the image in full"
        return 1
    fi
    if [ "${region}" != "${chip_region}" ]; then
        echo "bios-update: image and chip disagree on the BIOS region" \
             "(${region} vs ${chip_region}) — flashing the image in full"
        return 1
    fi

    # Everything below the BIOS region is what we keep from the chip.
    base=0
    len="${region% *}"
    if [ "${len}" -le 0 ] || [ $(( len % 4096 )) -ne 0 ]; then
        echo "bios-update: BIOS region does not start on a 4 KiB boundary above 0" \
             "— flashing the image as-is"
        return 1
    fi

    # The image must actually contain that span, or dd would extend it.
    if [ "$(stat -c %s "${IMAGE_FILE}" 2>/dev/null || echo 0)" -lt $(( base + len )) ]; then
        echo "bios-update: image is shorter than its own BIOS region base —" \
             "flashing it as-is"
        return 1
    fi

    # /tmp is a tmpfs and the image is ~32 MB; do not fill RAM.
    need_kb=$(( ( $(stat -c %s "${IMAGE_FILE}") / 1024 ) + 4096 ))
    avail_kb=$(df -k "${IMAGE_DIR}" 2>/dev/null | awk 'NR==2 {print $4}')
    if [ -z "${avail_kb}" ] || [ "${avail_kb}" -lt "${need_kb}" ]; then
        echo "bios-update: not enough space for an ME-preserving copy" \
             "(need ${need_kb} KiB, have ${avail_kb:-0} KiB) — flashing the image as-is"
        return 1
    fi

    tmp="${IMAGE_DIR}/image-bios.me-preserved"
    rm -f "${tmp}"
    ME_PRESERVED_FILE="${tmp}"          # so cleanup() removes it on any exit

    cnt=$(( len / 4096 ))
    printf 'bios-update: preserving chip bytes 0x%08x-0x%08x (%s KiB: descriptor, GbE, ME, pre-BIOS)\n' \
        "${base}" "$(( base + len - 1 ))" "$(( len / 1024 ))"

    # Build the spliced image by concatenation: the preserved span always starts
    # at offset 0, so this needs no in-place patching.  That matters -- BusyBox
    # dd here is built without conv= support at all ("Usage: dd [if=FILE]
    # [of=FILE] [bs=N] [count=N] [skip=N] [seek=N]"), so conv=notrunc fails, and
    # it silently cost us a working splice until it was tested on the BMC.  As a
    # bonus this skips a 32 MB copy.
    if ! { dd if="${PNOR_DEV}"   bs=4096 count="${cnt}" 2>/dev/null &&
           dd if="${IMAGE_FILE}" bs=4096 skip="${cnt}"  2>/dev/null ; } > "${tmp}"
    then
        echo "bios-update: splice failed — flashing the original image as-is"
        rm -f "${tmp}"; ME_PRESERVED_FILE=""
        return 1
    fi
    sync

    # Prove it: same size, preserved span identical to the chip, and the rest
    # still the image's.
    if [ "$(stat -c %s "${tmp}" 2>/dev/null)" != "$(stat -c %s "${IMAGE_FILE}")" ]; then
        echo "bios-update: spliced image is the wrong size — flashing the original as-is"
        rm -f "${tmp}"; ME_PRESERVED_FILE=""
        return 1
    fi
    if ! dd if="${tmp}" bs=4096 count="${cnt}" 2>/dev/null \
         | cmp -s - <(dd if="${PNOR_DEV}" bs=4096 count="${cnt}" 2>/dev/null)
    then
        echo "bios-update: splice did not verify against the chip —" \
             "flashing the original image as-is"
        rm -f "${tmp}"; ME_PRESERVED_FILE=""
        return 1
    fi
    if ! dd if="${tmp}" bs=4096 skip="${cnt}" 2>/dev/null \
         | cmp -s - <(dd if="${IMAGE_FILE}" bs=4096 skip="${cnt}" 2>/dev/null)
    then
        echo "bios-update: spliced image lost the new BIOS region —" \
             "flashing the original image as-is"
        rm -f "${tmp}"; ME_PRESERVED_FILE=""
        return 1
    fi

    IMAGE_FILE="${tmp}"
    ME_STATE="unchanged"
    echo "bios-update: ME and descriptor preserved — flashcp will write the BIOS" \
         "region only, no power cycle needed"
    return 0
}

# ── hot-swap controller node cycle ───────────────────────────────────────────

HSC_SYSFS="/sys/bus/i2c/devices/${HSC_BUS}-$(printf '%04x' "${HSC_ADDR}")"
HSC_CMD="i2cset -f -y ${HSC_BUS} ${HSC_ADDR} ${HSC_REG} ${HSC_MODE}"

schedule_hsc_cycle() {
    # The cycle drops the BMC too — instantly, with no graceful shutdown — so it
    # must not run inline: this script has to exit first, so systemd can mark the
    # unit "done" and phosphor-software-manager can record the new BIOS version.
    # A transient systemd timer survives our own cgroup going away.
    if [ ! -d "${HSC_SYSFS}" ]; then
        echo "bios-update: no hot-swap controller at ${HSC_SYSFS}"
        echo "bios-update: ACTION REQUIRED: remove AC power from the node, then" \
             "power it back on."
        return 0
    fi
    echo "bios-update: scheduling node power cycle in ${CYCLE_DELAY_S}s (${HSC_CMD})"
    echo "bios-update: the BMC will drop with it and take about 4 minutes to return"
    if systemd-run --on-active="${CYCLE_DELAY_S}" \
                   --unit=bios-update-node-cycle \
                   --description="Post-BIOS-update node power cycle (ME region changed)" \
                   /bin/sh -c "sync; ${HSC_CMD}" >/dev/null 2>&1; then
        return 0
    fi
    echo "bios-update: warning: could not schedule the cycle"
    echo "bios-update: ACTION REQUIRED: run '${HSC_CMD}' or remove AC power."
    return 0
}

# ── systemd watchdog guard ───────────────────────────────────────────────────
# A full BIOS flashcp takes ~4 min and hammers the AHB bus enough to starve
# systemd (PID1), so the aspeed hardware watchdog (RuntimeWatchdogUSec, default
# 2 min, pretimeout=panic) fires and RESETS THE BMC mid-write — leaving a
# half-written, corrupt host BIOS.  Disarm it for the duration of the flash and
# always re-arm it afterwards (including via the cleanup trap on any failure).

WDT_MGR="org.freedesktop.systemd1 /org/freedesktop/systemd1 org.freedesktop.systemd1.Manager"
_wdt_disarmed=0
_wdt_saved=""

wdt_disarm() {
    _wdt_saved=$(busctl get-property ${WDT_MGR} RuntimeWatchdogUSec 2>/dev/null | awk '{print $2}')
    case "${_wdt_saved}" in ''|0) _wdt_saved=120000000 ;; esac
    echo "bios-update: disarming systemd watchdog (was ${_wdt_saved} us) for the flash"
    if busctl set-property ${WDT_MGR} RuntimeWatchdogUSec t 0 2>/dev/null; then
        _wdt_disarmed=1
    else
        echo "bios-update: warning: could not disarm systemd watchdog (continuing)"
    fi
}

wdt_rearm() {
    if [ "${_wdt_disarmed}" = "1" ]; then
        echo "bios-update: re-arming systemd watchdog (${_wdt_saved} us)"
        busctl set-property ${WDT_MGR} RuntimeWatchdogUSec t "${_wdt_saved}" 2>/dev/null \
            || echo "bios-update: warning: could not re-arm systemd watchdog"
        _wdt_disarmed=0
    fi
}

# ── cleanup trap ──────────────────────────────────────────────────────────────
# Runs on any exit (success or failure) — ensures SPI bus returns to PCH.

_cleanup_done=0
cleanup() {
    if [ "${_cleanup_done}" = "0" ]; then
        _cleanup_done=1
        spi_unbind 2>/dev/null || true
        spi_mux_to_pch 2>/dev/null || true
    fi
    # Always restore the watchdog, even on a failed/partial flash (idempotent).
    wdt_rearm 2>/dev/null || true
    # The ME-preserving copy is ~32 MB of tmpfs; never leave it behind.
    [ -n "${ME_PRESERVED_FILE}" ] && rm -f "${ME_PRESERVED_FILE}" 2>/dev/null
    return 0
}
trap cleanup EXIT

# ── pre-flight ────────────────────────────────────────────────────────────────

if [ -z "${IMAGE_DIR}" ]; then
    echo "bios-update: error: no image directory argument"
    exit 1
fi

if [ ! -f "${IMAGE_FILE}" ]; then
    echo "bios-update: error: image not found: ${IMAGE_FILE} (tar must contain 'image-bios')"
    exit 1
fi

echo "bios-update: BIOS update started at $(date)"
echo "bios-update: image: ${IMAGE_FILE} ($(du -h "${IMAGE_FILE}" | cut -f1))"

# ── power off host ────────────────────────────────────────────────────────────

echo "bios-update: powering off host"
obmcutil poweroff
# wait up to 60s for host to reach Off state
for i in $(seq 1 12); do
    sleep 5
    STATE=$(busctl get-property xyz.openbmc_project.State.Host \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host CurrentHostState 2>/dev/null | awk '{print $2}' | tr -d '"')
    echo "bios-update: host state: ${STATE}"
    case "${STATE}" in
        *Off*|*Standby*)
            break
            ;;
    esac
    if [ "${i}" -eq 12 ]; then
        echo "bios-update: error: host did not power off after 60s"
        exit 1
    fi
done

# ── take the SPI bus ──────────────────────────────────────────────────────────
# Switch mux FIRST so that when the driver rebinds, the JEDEC probe succeeds.

spi_mux_to_bmc
sleep 1
spi_unbind
spi_bind

# ── find pnor MTD ─────────────────────────────────────────────────────────────
# After rebind the spi-nor driver will probe spi1.0 and create a pnor MTD.
# Retry a few times in case the MTD registration is slightly delayed.

PNOR_DEV=""
for i in $(seq 1 5); do
    PNOR_DEV=$(find_pnor_dev) && break || true
    echo "bios-update: waiting for pnor MTD (attempt ${i}/5)..."
    sleep 2
done

if [ -z "${PNOR_DEV}" ]; then
    echo "bios-update: error: pnor MTD partition not found after driver bind"
    exit 1
fi

# ── does this update change the ME region? ────────────────────────────────────
# Must run before the flash, while the chip still holds the outgoing image.

detect_me_change

# If it differs, preserve the chip's ME rather than rewriting it, so the node
# does not need a G3.  preserve_chip_me() flips ME_STATE back to "unchanged"
# only once it has verified the spliced copy against the chip.
if [ "${ME_STATE}" = "changed" ]; then
    if [ "${WRITE_ME}" = "1" ]; then
        echo "bios-update: BIOS_UPDATE_WRITE_ME=1 — writing the image's ME region;" \
             "the node will need a G3 afterwards"
    else
        preserve_chip_me || true
    fi
fi

if [ "${ME_STATE}" = "changed" ]; then
    echo "bios-update: the ME region will be rewritten — the node must go through" \
         "G3 after the flash or it will not power on"
fi

echo "bios-update: flashing ${IMAGE_FILE} → ${PNOR_DEV}"

# ── flash ─────────────────────────────────────────────────────────────────────
# Disarm the watchdog only around the long write, then re-arm immediately so the
# BMC is unprotected for the shortest possible window.
#
# -p erases and writes only the eraseblocks that differ, and reads each one back
# and compares it immediately after writing, so verification coverage is the same
# as a full-chip write.  Blocks it skips already matched the image.

wdt_disarm
flashcp -v -p "${IMAGE_FILE}" "${PNOR_DEV}"
wdt_rearm

echo "bios-update: flash complete"

# ── release the SPI bus ───────────────────────────────────────────────────────
# Unbind and return bus to PCH before powering on host.
# The cleanup trap will also run on exit but this makes the log clearer.

_cleanup_done=1
spi_unbind
sleep 2
spi_mux_to_pch
sleep 2

# ── bring the host back ───────────────────────────────────────────────────────
# Two different endings, decided by whether the ME region was rewritten.

if [ "${ME_STATE}" = "changed" ]; then
    # The PCH will not enter S0 until input power has actually been removed.
    # obmcutil poweron would fail at PS_PWROK, and so would the front-panel
    # button, so do not pretend otherwise — cycle the node instead.
    echo "bios-update: ME region was rewritten; a soft power-on cannot work here"
    if [ "${AUTO_POWER_CYCLE}" = "1" ]; then
        schedule_hsc_cycle
    else
        echo "bios-update: automatic power cycle disabled" \
             "(BIOS_UPDATE_AUTO_POWER_CYCLE=0)"
        echo "bios-update: ACTION REQUIRED: run '${HSC_CMD}' or remove AC power," \
             "then power the host on."
    fi
    echo "bios-update: done at $(date)"
    exit 0
fi

# ── power on host ─────────────────────────────────────────────────────────────
# Use obmcutil to drive x86-power-control's normal power-on path
# (xyz.openbmc_project.Chassis.Control.Power@0).  Fighting power-control
# for the power-button GPIO directly never worked — it owns those lines
# for the lifetime of the service.

echo "bios-update: powering on host (obmcutil poweron)"
obmcutil poweron || true

# Poll up to 60s for the host to leave Off.
STATE="unknown"
for _i in $(seq 1 12); do
    sleep 5
    STATE=$(busctl get-property xyz.openbmc_project.State.Host \
        /xyz/openbmc_project/state/host0 \
        xyz.openbmc_project.State.Host CurrentHostState 2>/dev/null \
        | awk '{print $2}' | tr -d '"')
    case "${STATE}" in
        *Off*) ;;
        *) break ;;
    esac
done
echo "bios-update: host state after power-on: ${STATE:-unknown}"

# The ME was not touched, so this should have worked.  If it did not, the node
# is in the separate PS_PWROK/POWER_OUT failure mode, not the ME lockout.
case "${STATE}" in
    *Off*|unknown)
        echo "bios-update: host did not come up, and the ME was NOT rewritten —" \
             "this is not the post-ME-flash lockout."
        echo "bios-update: recovery of last resort: '${HSC_CMD}' (cycles the whole" \
             "node, drops the BMC with it)."
        ;;
esac

echo "bios-update: done at $(date)"
exit 0
