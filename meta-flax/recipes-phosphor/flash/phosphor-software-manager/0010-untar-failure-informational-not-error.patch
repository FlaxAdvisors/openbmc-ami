From 0000000000000000000000000000000000000010 Mon Sep 17 00:00:00 2001
From: flax <flax@tiogapass>
Date: Thu, 05 Jun 2026 00:00:00 +0000
Subject: [PATCH] log UnTarFailure as Informational, not Error

A failed tar extraction of an uploaded firmware image
(xyz.openbmc_project.Software.Image.Error.UnTarFailure) is defined as
level ERR in phosphor-dbus-interfaces, so bmcweb maps it to Redfish
Critical and it drives the WebUI Health badge to "bad".  But a bad,
truncated or corrupt upload does not harm the running system - the
update simply fails and the operator retries.

Pass Entry::Level::Informational to report<UnTarFailure>() at every
call site so the event is recorded (Redfish "OK") without raising a
false critical-health alarm.  Done here rather than in the shared
phosphor-dbus-interfaces metadata YAML to avoid a base-layer rebuild
and to keep the change scoped to this consumer.

Upstream-Status: Inappropriate [single-platform policy]
---
 image_manager.cpp | 10 +++++-----
 1 file changed, 5 insertions(+), 5 deletions(-)

diff --git a/image_manager.cpp b/image_manager.cpp
index 1111111..2222222 100644
--- a/image_manager.cpp
+++ b/image_manager.cpp
@@ -305,13 +305,13 @@
     if (tarFilePath.empty())
     {
         error("TarFilePath is empty");
-        report<UnTarFailure>(UnTarFail::PATH(tarFilePath.c_str()));
+        report<UnTarFailure>(Entry::Level::Informational, UnTarFail::PATH(tarFilePath.c_str()));
         return -1;
     }
     if (extractDirPath.empty())
     {
         error("ExtractDirPath is empty");
-        report<UnTarFailure>(UnTarFail::PATH(extractDirPath.c_str()));
+        report<UnTarFailure>(Entry::Level::Informational, UnTarFail::PATH(extractDirPath.c_str()));
         return -1;
     }
 
@@ -327,7 +327,7 @@
               extractDirPath.c_str(), (char*)0);
         // execl only returns on fail
         error("Failed to execute untar on {PATH}", "PATH", tarFilePath);
-        report<UnTarFailure>(UnTarFail::PATH(tarFilePath.c_str()));
+        report<UnTarFailure>(Entry::Level::Informational, UnTarFail::PATH(tarFilePath.c_str()));
         return -1;
     }
     else if (pid > 0)
@@ -337,14 +337,14 @@
         {
             error("Failed ({STATUS}) to untar file {PATH}", "STATUS", status,
                   "PATH", tarFilePath);
-            report<UnTarFailure>(UnTarFail::PATH(tarFilePath.c_str()));
+            report<UnTarFailure>(Entry::Level::Informational, UnTarFail::PATH(tarFilePath.c_str()));
             return -1;
         }
     }
     else
     {
         error("fork() failed: {ERRNO}", "ERRNO", errno);
-        report<UnTarFailure>(UnTarFail::PATH(tarFilePath.c_str()));
+        report<UnTarFailure>(Entry::Level::Informational, UnTarFail::PATH(tarFilePath.c_str()));
         return -1;
     }
 
