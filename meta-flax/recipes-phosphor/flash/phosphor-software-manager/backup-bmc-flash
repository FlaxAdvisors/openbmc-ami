#!/bin/bash
# backup-bmc-flash — write a BMC firmware image to the backup FMC CS1 flash chip.
#
# Usage: backup-bmc-flash <image-bmc>
#
# <image-bmc> is the static.mtd image produced by the build:
#   build/tiogapass/tmp/deploy/images/tiogapass/obmc-phosphor-image-tiogapass.static.mtd
#
# The image is written to the MTD device labelled "bmc-backup" (FMC CS1).
# The chip is written raw from offset 0 — no sub-partitions are needed because
# the chip is only ever used as a cold-boot device in the primary CS0 socket.
#
# flashcp erases only the blocks it writes, so a smaller image does not wipe
# any trailing area, but for a bootable chip the full static.mtd must be used.

set -e

IMAGE="${1}"

# ── pre-flight ────────────────────────────────────────────────────────────────

if [ -z "${IMAGE}" ]; then
    echo "backup-bmc-flash: usage: backup-bmc-flash <image-bmc>" >&2
    exit 1
fi

if [ ! -f "${IMAGE}" ]; then
    echo "backup-bmc-flash: error: image not found: ${IMAGE}" >&2
    exit 1
fi

IMAGE_SIZE=$(stat -c %s "${IMAGE}")
echo "backup-bmc-flash: image: ${IMAGE} ($(( IMAGE_SIZE / 1024 / 1024 )) MB)"

# ── find the backup MTD ───────────────────────────────────────────────────────

BACKUP_MTD=""
for namefile in /sys/class/mtd/*/name; do
    if [ "$(cat "${namefile}" 2>/dev/null)" = "bmc-backup" ]; then
        BACKUP_MTD="/dev/$(basename "$(dirname "${namefile}")")"
        break
    fi
done

if [ -z "${BACKUP_MTD}" ]; then
    echo "backup-bmc-flash: error: 'bmc-backup' MTD partition not found." >&2
    echo "  Is a chip installed in the FMC CS1 socket?" >&2
    echo "  Is the kernel built with the FMC CS1 DTS node enabled?" >&2
    exit 1
fi

echo "backup-bmc-flash: target device: ${BACKUP_MTD}"

# Sanity-check: chip size must be >= image size
MTD_SIZE=$(cat "$(dirname "$(find /sys/class/mtd -name name | xargs grep -l "^bmc-backup$" 2>/dev/null | head -n 1)")/size" 2>/dev/null || echo 0)
if [ "${MTD_SIZE}" -gt 0 ] && [ "${IMAGE_SIZE}" -gt "${MTD_SIZE}" ]; then
    echo "backup-bmc-flash: error: image (${IMAGE_SIZE} B) is larger than chip (${MTD_SIZE} B)" >&2
    exit 1
fi

# ── flash ─────────────────────────────────────────────────────────────────────

echo "backup-bmc-flash: writing to ${BACKUP_MTD} (this takes ~2 minutes)..."
flashcp -v "${IMAGE}" "${BACKUP_MTD}"

echo "backup-bmc-flash: done — backup chip is ready."
echo "  To use: power off the BMC, swap the chip to the CS0 socket, power on."
