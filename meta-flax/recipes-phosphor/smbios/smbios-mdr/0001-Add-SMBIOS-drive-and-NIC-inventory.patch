+#include "nic.hpp"
+
+#include <phosphor-logging/log.hpp>
+
+#include <algorithm>
+#include <string>
+
+namespace phosphor
+{
+namespace smbios
+{
+
+/*
+ * SMBIOS type 10 (Onboard Devices) structure layout:
+ *
+ *   Offset  Size  Description
+ *     0      1    Type = 10
+ *     1      1    Length (covers header + device array)
+ *     2      2    Handle
+ *     4+     2*N  Device entries: [type_byte, string_index]
+ *                   type_byte bit7 = enabled, bits 0-6 = device type
+ *                   device type 5 = Ethernet
+ *
+ * Number of device entries = (Length - 4) / 2
+ */
+static constexpr uint8_t onboardDeviceEthernet = 5;
+
+void Nic::nicInfoUpdate(uint8_t* smbiosTableStorage,
+                         const std::string& motherboard)
+{
+    storage = smbiosTableStorage;
+    motherboardPath = motherboard;
+
+    uint8_t* dataIn = getSMBIOSTypePtr(storage, onBoardDevicesType);
+
+    if (dataIn == nullptr)
+    {
+        phosphor::logging::log<phosphor::logging::level::DEBUG>(
+            "No Onboard Devices SMBIOS record found");
+        return;
+    }
+
+    uint8_t structLen = *(dataIn + 1);
+    if (structLen < 4)
+    {
+        return;
+    }
+
+    /* Scan all device entries in this type-10 record for the nicNum-th
+     * Ethernet device */
+    uint8_t numDevices = (structLen - 4) / 2;
+    uint8_t ethernetCount = 0;
+    uint8_t stringIndex = 0;
+    bool found = false;
+
+    for (uint8_t i = 0; i < numDevices; i++)
+    {
+        uint8_t* entry = dataIn + 4 + (i * 2);
+        uint8_t typeByte = *entry;
+        uint8_t devType = typeByte & 0x7F;
+
+        if (devType == onboardDeviceEthernet)
+        {
+            if (ethernetCount == nicNum)
+            {
+                stringIndex = *(entry + 1);
+                found = true;
+                break;
+            }
+            ethernetCount++;
+        }
+    }
+
+    if (!found || stringIndex == 0)
+    {
+        return;
+    }
+
+    std::string rawName = positionToString(stringIndex, structLen, dataIn);
+
+    /* Strip leading whitespace */
+    size_t start = rawName.find_first_not_of(' ');
+    std::string name = (start == std::string::npos) ? rawName
+                                                    : rawName.substr(start);
+
+    /* Split at first space: first token = manufacturer, rest = model.
+     * If there is no space the whole string becomes the model. */
+    size_t sp = name.find(' ');
+    if (sp != std::string::npos)
+    {
+        nicAsset::manufacturer(name.substr(0, sp));
+        nicAsset::model(name.substr(sp + 1));
+    }
+    else
+    {
+        nicAsset::manufacturer("");
+        nicAsset::model(name);
+    }
+
+    nicItem::present(true);
+
+    if (!motherboardPath.empty())
+    {
+        std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+        assocs.emplace_back("chassis", "nics", motherboardPath);
+        nicAssociation::associations(assocs);
+    }
+}
+
