From 0000000000000000000000000000000000000001 Mon Sep 17 00:00:00 2001
From: TiogaPass BMC <bmc@tiogapass>
Date: Mon, 30 Mar 2026 00:00:00 +0000
Subject: [PATCH] Add SMBIOS NVMe drive (OEM type 0xC2) and NIC (type 10)
 inventory to D-Bus

Parse OEM SMBIOS type 0xC2 (Intel NVMe namespace) records and publish each
drive as xyz.openbmc_project.Inventory.Item.Drive + Decorator.Asset on D-Bus.

Parse SMBIOS type 10 (Onboard Devices) records and expose each Ethernet device
(type nibble == 5) as xyz.openbmc_project.Inventory.Item.FabricAdapter +
Decorator.Asset on D-Bus.

D-Bus paths:
  /xyz/openbmc_project/inventory/system/drive/<N>
  /xyz/openbmc_project/inventory/system/nic/<N>
---
diff --git a/include/drive.hpp b/include/drive.hpp
new file mode 100644
index 0000000..c50cfed
--- /dev/null
+++ b/include/drive.hpp
@@ -0,0 +1,67 @@
+#pragma once
+#include "smbios_mdrv2.hpp"
+
+#include <xyz/openbmc_project/Association/Definitions/server.hpp>
+#include <xyz/openbmc_project/Inventory/Decorator/Asset/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/Drive/server.hpp>
+#include <xyz/openbmc_project/Inventory/Item/server.hpp>
+
+#include <cstdint>
+#include <string>
+
+namespace phosphor
+{
+
+namespace smbios
+{
+
+using DriveIface =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::Drive;
+using DriveType =
+    sdbusplus::server::xyz::openbmc_project::inventory::item::Drive::DriveType;
+using DriveProtocol = sdbusplus::server::xyz::openbmc_project::inventory::
+    item::Drive::DriveProtocol;
+using driveAsset =
+    sdbusplus::server::xyz::openbmc_project::inventory::decorator::Asset;
+using driveItem =
+    sdbusplus::server::xyz::openbmc_project::inventory::Item;
+using driveAssociation =
+    sdbusplus::server::xyz::openbmc_project::association::Definitions;
+
+class Drive :
+    sdbusplus::server::object_t<DriveIface, driveAsset, driveItem,
+                                driveAssociation>
+{
+  public:
+    Drive() = delete;
+    Drive(const Drive&) = delete;
+    Drive& operator=(const Drive&) = delete;
+    Drive(Drive&&) = delete;
+    Drive& operator=(Drive&&) = delete;
+    ~Drive() = default;
+
+    Drive(sdbusplus::bus_t& bus, const std::string& objPath,
+          const uint8_t& driveId, uint8_t* smbiosTableStorage,
+          const std::string& motherboard) :
+        sdbusplus::server::object_t<DriveIface, driveAsset, driveItem,
+                                    driveAssociation>(bus, objPath.c_str()),
+        driveNum(driveId)
+    {
+        driveInfoUpdate(smbiosTableStorage, motherboard);
+    }
+
+    void driveInfoUpdate(uint8_t* smbiosTableStorage,
+                         const std::string& motherboard);
+
+  private:
+    uint8_t driveNum;
+    uint8_t* storage;
+    std::string motherboardPath;
+};
+
+/* OEM type for Intel NVMe namespace records */
+static constexpr uint8_t nvmeSmbiosType = 0xC2;
+
+}; // namespace smbios
+
+}; // namespace phosphor
