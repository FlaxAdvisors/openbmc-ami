+std::optional<size_t> MDRV2::getTotalDriveSlot()
+{
+    uint8_t* dataIn = smbiosDir.dir[smbiosDirIndex].dataStorage;
+    size_t num = 0;
+
+    if (dataIn == nullptr)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(
+            "Fail to get total NVMe drive slot - no storage data");
+        return std::nullopt;
+    }
+
+    while (1)
+    {
+        dataIn = getSMBIOSTypePtr(dataIn, nvmeSmbiosType);
+        if (dataIn == nullptr)
+        {
+            break;
+        }
+        num++;
+        dataIn = smbiosNextPtr(dataIn);
+        if (dataIn == nullptr)
+        {
+            break;
+        }
+        if (num >= limitEntryLen)
+        {
+            break;
+        }
+    }
+
+    return num;
+}
+
+std::optional<size_t> MDRV2::getTotalNicSlot()
+{
+    uint8_t* dataIn = smbiosDir.dir[smbiosDirIndex].dataStorage;
+    size_t num = 0;
+
+    if (dataIn == nullptr)
+    {
+        phosphor::logging::log<phosphor::logging::level::ERR>(
+            "Fail to get total NIC slot - no storage data");
+        return std::nullopt;
+    }
+
+    dataIn = getSMBIOSTypePtr(dataIn, onBoardDevicesType);
+    if (dataIn == nullptr)
+    {
+        return num;
+    }
+
+    uint8_t structLen = *(dataIn + 1);
+    if (structLen < 4)
+    {
+        return num;
+    }
+
+    uint8_t numDevices = (structLen - 4) / 2;
+    for (uint8_t i = 0; i < numDevices; i++)
+    {
+        uint8_t* entry = dataIn + 4 + (i * 2);
+        uint8_t devType = (*entry) & 0x7F;
+        if (devType == 5) /* Ethernet */
+        {
+            num++;
+        }
+        if (num >= limitEntryLen)
+        {
+            break;
+        }
+    }
+
+    return num;
+}
