+
+void Drive::driveInfoUpdate(uint8_t* smbiosTableStorage,
+                             const std::string& motherboard)
+{
+    storage = smbiosTableStorage;
+    motherboardPath = motherboard;
+
+    uint8_t* dataIn = getSMBIOSTypePtr(storage, nvmeSmbiosType);
+
+    if (dataIn == nullptr)
+    {
+        phosphor::logging::log<phosphor::logging::level::DEBUG>(
+            "No OEM NVMe SMBIOS records found");
+        return;
+    }
+
+    /* Walk to the driveNum-th occurrence of nvmeSmbiosType */
+    for (uint8_t index = 0; index < driveNum;)
+    {
+        dataIn = smbiosNextPtr(dataIn);
+        if (dataIn == nullptr)
+        {
+            return;
+        }
+        dataIn = getSMBIOSTypePtr(dataIn, nvmeSmbiosType);
+        if (dataIn == nullptr)
+        {
+            return;
+        }
+        index++;
+    }
+
+    uint8_t structLen = *(dataIn + 1);
+
+    /*
+     * OEM type 0xC2 string layout (1-indexed after fixed header):
+     *   [1] = namespace name  (e.g. "NVMe NameSpace 1")
+     *   [2] = device model    (e.g. "INTEL SSDPEKNW512G8")
+     *   [3] = serial number   (e.g. "BTNH90350E9W512A")
+     */
+    driveAsset::model(positionToString(2, structLen, dataIn));
+    driveAsset::serialNumber(positionToString(3, structLen, dataIn));
+    driveAsset::manufacturer("Intel");
+
+    DriveIface::type(DriveType::SSD);
+    DriveIface::protocol(DriveProtocol::NVMe);
+
+    driveItem::present(true);
+
+    if (!motherboardPath.empty())
+    {
+        std::vector<std::tuple<std::string, std::string, std::string>> assocs;
+        assocs.emplace_back("chassis", "drives", motherboardPath);
+        driveAssociation::associations(assocs);
+    }
+}
+
+} // namespace smbios
+} // namespace phosphor
