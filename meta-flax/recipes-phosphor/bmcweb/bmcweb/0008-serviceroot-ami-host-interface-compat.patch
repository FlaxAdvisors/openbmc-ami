From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Flax <hmccanne@exclamationpoint.com>
Date: Fri, 31 Jul 2026 16:45:00 +0000
Subject: [PATCH] redfish: AMI-compatible service root on the host interface only

The TiogaPass (Wiwynn TP26 / TPC_P26C) BIOS discovers the BMC's Redfish Host
Interface during POST with a single unauthenticated

    GET /redfish/v1/
    Accept: application/json;charset=utf-8
    OData-Version: 4.0

over the USB host interface, and only proceeds to its inventory push if it
accepts the response.  Against stock bmcweb it reads the service root, gets a
well-formed 200 + JSON, and immediately RSTs without issuing a second request.

The OEM MegaRAC service root the BIOS does accept was captured from the same
machine on 2026-07-31 (oem-reference/protocol-reverse/live-2026-07-31/) by
enabling lighttpd access logging.  It differs in schema revision
(ServiceRoot.v1_3_1 / RedfishVersion 1.5.0), a trailing-slash @odata.id, an
@odata.context, a Product string, and an Oem/Ami block carrying Configurations
and RtpVersion.  It emits no Vendor property, so neither do we.

These values are scoped to requests arriving on the USB host interface (IPv4
link-local peer, 169.254.0.0/16).  Normal management clients on eth0 continue
to see bmcweb's real schema revision and RedfishVersion -- we must not
misreport our actual Redfish version to users just to satisfy the BIOS.

---
diff --git a/redfish-core/lib/service_root.hpp b/redfish-core/lib/service_root.hpp
index 73eaff81..19a4e5cd 100644
--- a/redfish-core/lib/service_root.hpp
+++ b/redfish-core/lib/service_root.hpp
@@ -33,8 +33,31 @@ inline void
         "</redfish/v1/JsonSchemas/ServiceRoot/ServiceRoot.json>; rel=describedby");
 }
 
+// True when the peer is an IPv4 link-local address, i.e. the host BIOS talking
+// to us over the USB Redfish Host Interface (observed 169.254.0.18 ->
+// 169.254.0.17).  Depending on the listening socket boost may hand us the
+// v4-mapped IPv6 form (::ffff:169.254.0.18), so handle both without relying on
+// the deprecated v4_mapped conversion helpers.
+inline bool isHostInterfacePeer(const crow::Request& req)
+{
+    const boost::asio::ip::address& addr = req.ipAddress;
+    if (addr.is_v4())
+    {
+        auto b = addr.to_v4().to_bytes();
+        return b[0] == 169 && b[1] == 254;
+    }
+    if (addr.is_v6())
+    {
+        auto b = addr.to_v6().to_bytes();
+        bool v4Mapped = b[10] == 0xff && b[11] == 0xff;
+        return v4Mapped && b[12] == 169 && b[13] == 254;
+    }
+    return false;
+}
+
 inline void handleServiceRootGetImpl(
-    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
+    const std::shared_ptr<bmcweb::AsyncResp>& asyncResp,
+    bool hostInterface = false)
 {
     asyncResp->res.addHeader(
         boost::beast::http::field::link,
@@ -47,6 +70,27 @@ inline void handleServiceRootGetImpl(
     asyncResp->res.jsonValue["Name"] = "Root Service";
     asyncResp->res.jsonValue["Description"] = "Root Service";
     asyncResp->res.jsonValue["RedfishVersion"] = "1.17.0";
+    if (hostInterface)
+    {
+        // AMI host-interface compatibility.  The TP26 BIOS rejects our stock
+        // service root and aborts its inventory push; these are the values the
+        // OEM MegaRAC service root presents, captured on 2026-07-31.  Scoped to
+        // the host interface so real management clients keep seeing our true
+        // schema revision and RedfishVersion.  Do not "modernise" these without
+        // re-testing the BIOS inventory push.
+        asyncResp->res.jsonValue["@odata.type"] =
+            "#ServiceRoot.v1_3_1.ServiceRoot";
+        asyncResp->res.jsonValue["@odata.context"] =
+            "/redfish/v1/$metadata#ServiceRoot.ServiceRoot";
+        asyncResp->res.jsonValue["@odata.id"] = "/redfish/v1/";
+        asyncResp->res.jsonValue["Description"] =
+            "The service root for all Redfish requests on this host";
+        asyncResp->res.jsonValue["RedfishVersion"] = "1.5.0";
+        asyncResp->res.jsonValue["Product"] = "AMI Redfish Server";
+        asyncResp->res.jsonValue["Oem"]["Ami"]["Configurations"]["@odata.id"] =
+            "/redfish/v1/configurations";
+        asyncResp->res.jsonValue["Oem"]["Ami"]["RtpVersion"] = "1.5.b";
+    }
     asyncResp->res.jsonValue["Links"]["Sessions"]["@odata.id"] =
         "/redfish/v1/SessionService/Sessions";
     asyncResp->res.jsonValue["AccountService"]["@odata.id"] =
@@ -157,7 +201,7 @@ inline void
         return;
     }
 
-    handleServiceRootGetImpl(asyncResp);
+    handleServiceRootGetImpl(asyncResp, isHostInterfacePeer(req));
 }
 
 inline void requestRoutesServiceRoot(App& app)
