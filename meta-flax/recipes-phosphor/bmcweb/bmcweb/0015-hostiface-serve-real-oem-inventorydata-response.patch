 // The inventory blob itself -- this is the one the translator consumes.
+// Split one OEM push into the per-group collection files the translator
+// already consumes.  The per-item schemas are byte-identical between the OEM
+// payload and the generic-Redfish fallback (verified against the 2026-08-17
+// capture), so flax-hi-inventory needs no changes at all to publish this.
+//
+// MERGE, NEVER REPLACE.  A steady-state boot sends an 850-byte delta carrying
+// only GroupCrcList and static identity -- no Memory, Processors or PCIe at
+// all.  Wiping a group because this payload does not mention it would erase
+// the inventory on the first no-change boot.  (The OEM makes exactly this
+// distinction: its 850-byte delta overwrote the stored inventory.json while
+// its redis still held all 25 PCIe devices.)
+inline void flaxTouchInventoryStamp(); // defined with the collection receivers
+
+inline void flaxNormalizeOemInventory()
+{
+    // Read what handleFlaxUpload just persisted rather than the request body:
+    // the BIOS posts multipart/form-data, and the upload path has already
+    // extracted the file part for us.
+    std::ifstream in("/var/lib/flax-inventory/inventory.json");
+    if (!in)
+    {
+        BMCWEB_LOG_ERROR("flax-hi: no stored inventory.json to normalize");
+        return;
+    }
+    nlohmann::json payload = nlohmann::json::parse(in, nullptr, false);
+    if (payload.is_discarded() || !payload.is_object())
+    {
+        BMCWEB_LOG_ERROR("flax-hi: OEM push is not JSON -- kept raw only");
+        return;
+    }
+
+    std::error_code ec;
+    const std::string root = "/var/lib/flax-inventory/collections";
+
+    auto writeGroup = [&](const std::string& group,
+                          const nlohmann::json& items,
+                          const char* idKey) {
+        if (!items.is_array() || items.empty())
+        {
+            return; // group absent from this push: keep what we have
+        }
+        const std::string dir = root + "/" + group;
+        std::filesystem::remove_all(dir, ec);
+        std::filesystem::create_directories(dir, ec);
+
+        size_t index = 0;
+        for (const auto& item : items)
+        {
+            std::string name = std::to_string(index);
+            if (idKey != nullptr && item.is_object())
+            {
+                auto id = item.find(idKey);
+                if (id != item.end() && id->is_string())
+                {
+                    name = flaxSafeName(id->get<std::string>(), name.c_str());
+                }
+            }
+            const std::string path = dir + "/" + name + ".json";
+            std::ofstream out(path, std::ofstream::out | std::ofstream::trunc);
+            if (out)
+            {
+                out << item.dump();
+            }
+            ++index;
+        }
+        BMCWEB_LOG_ERROR("flax-hi: OEM push -> {} ({} members)", group,
+                         items.size());
+    };
+
+    const auto& systems = payload["Systems"];
+    if (systems.is_array() && !systems.empty())
+    {
+        const auto& sys = systems[0];
+        writeGroup("memory", sys.value("Memory", nlohmann::json::array()),
+                   nullptr);
+        writeGroup("processors",
+                   sys.value("Processors", nlohmann::json::array()), nullptr);
+    }
+
+    const auto& chassisList = payload["Chassis"];
+    if (chassisList.is_array() && !chassisList.empty())
+    {
+        const auto& links = chassisList[0].value("Links", nlohmann::json());
+        if (links.is_object())
+        {
+            writeGroup("pcie",
+                       links.value("PCIeDevices", nlohmann::json::array()),
+                       "Id");
+        }
+    }
+
+    // Remember the CRCs verbatim.  The BIOS computes them; we only echo them
+    // back on the next GET so it can skip groups that have not changed.
+    const auto& crcs = payload["GroupCrcList"];
+    if (crcs.is_object())
+    {
+        std::ofstream out(flaxGroupCrcFile,
+                          std::ofstream::out | std::ofstream::trunc);
+        if (out)
+        {
+            out << crcs.dump();
+            BMCWEB_LOG_ERROR("flax-hi: stored GroupCrcList {}", crcs.dump());
+        }
+    }
+
+    // Wake the translator (same stamp the collection receivers touch).
+    flaxTouchInventoryStamp();
+}
+
 inline void handleFlaxInventoryUpload(
     crow::App& app, const crow::Request& req,
     const std::shared_ptr<bmcweb::AsyncResp>& asyncResp)
 {
     handleFlaxUpload(app, req, asyncResp, "", "inventory.json", true,
                      boost::beast::http::status::created);
+
+    // Only normalize a push we actually accepted.
+    if (asyncResp->res.result() == boost::beast::http::status::created)
+    {
+        flaxNormalizeOemInventory();
+    }
 }
 
