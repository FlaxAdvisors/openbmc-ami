-// We must NAME the groups.  An empty object is not "I have nothing, send
-// everything" -- captured 2026-08-11, against an empty GroupCrcList the BIOS
-// pushed the BIOS attribute blob and the setup static files and then stopped,
-// never sending POST/PATCH /redfish/v1/Oem/Ami/InventoryData, which are the
-// requests that carry the CPU/DIMM/PCIe data.  With no group names there is
-// nothing for it to compare its own CRCs against, so nothing reads as stale
-// and nothing gets pushed.
+// The real response was captured 2026-08-17 off the OEM chip and is
+// /vagrant/oem-reference/live-2026-08-17/hi-InventoryData.json (4135 bytes).
+// It is a normal Redfish document -- @odata.*, BiosStaticFiles, Chassis, DRE,
+// NetworkDeviceFunctions, Registries, SecureBoot, System -- and the group CRCs
+// live at System.Oem.Ami.Inventory.Crc.GroupCrcList as an ARRAY of one-key
+// objects, not the flat object the push payload uses.  Mirror it.
 //
-// So list the groups the OEM lists and report a CRC that cannot match a real
-// one.  Every group then always reads as stale and the BIOS pushes all of
-// them.  That is deliberate: we do not cache inventory, so we always want a
-// full push.  If we ever do cache it, replace the zeros with the real CRC of
-// what we hold.
+// Two deliberate divergences from the OEM body, both following the rule this
+// file already learned the hard way -- never advertise something you do not
+// serve:
+//
+//   - SecureBoot is OMITTED.  The OEM advertises #SecureBoot.ResetKeys and its
+//     BIOS then GETs that action target (200, 154 bytes).  We cannot reproduce
+//     that response, and the previous code advertised the action anyway with a
+//     target under /Systems/system/... that we do not route.  Omitting the
+//     block means the BIOS never asks.
+//   - DRE and NetworkDeviceFunctions are present but EMPTY.  We run no dynamic
+//     extensions and hold no host NIC data.  An empty array is dereferenceable;
+//     a missing key may not be.
+inline uint32_t flaxCrc32(const unsigned char* data, size_t len)
+{
+    // CRC-32/ISO-HDLC, the variant the OEM's BiosStaticFiles table uses.
+    static std::array<uint32_t, 256> table = [] {
+        std::array<uint32_t, 256> t{};
+        for (uint32_t i = 0; i < 256; i++)
+        {
+            uint32_t c = i;
+            for (int k = 0; k < 8; k++)
+            {
+                c = (c & 1U) ? (0xEDB88320U ^ (c >> 1)) : (c >> 1);
+            }
+            t[i] = c;
+        }
+        return t;
+    }();
+
+    uint32_t c = 0xFFFFFFFFU;
+    for (size_t i = 0; i < len; i++)
+    {
+        c = table[(c ^ data[i]) & 0xFFU] ^ (c >> 8);
+    }
+    return c ^ 0xFFFFFFFFU;
+}
+
+// CRC of every BIOS static asset we hold.  Advertising these is what stops the
+// BIOS re-uploading all seven files on every boot: it compares and uploads only
+// what changed.  A CRC that does not match simply costs a re-upload, so being
+// wrong here is safe -- being absent is what is expensive.
+inline nlohmann::json::object_t flaxBiosStaticFileCrcs()
+{
+    nlohmann::json::object_t crcs;
+    std::error_code ec;
+    const std::string dir = "/var/lib/flax-inventory/static";
+    for (const auto& entry : std::filesystem::directory_iterator(dir, ec))
+    {
+        if (!entry.is_regular_file(ec))
+        {
+            continue;
+        }
+        std::ifstream in(entry.path(), std::ios::binary);
+        if (!in)
+        {
+            continue;
+        }
+        std::string content((std::istreambuf_iterator<char>(in)),
+                            std::istreambuf_iterator<char>());
+        crcs[entry.path().filename().string()] = flaxCrc32(
+            reinterpret_cast<const unsigned char*>(content.data()),
+            content.size());
+    }
+    return crcs;
+}
+
+// The CRCs the BIOS itself sent us last time.  We never compute these: the
+// BIOS ships GroupCrcList in its push and the BMC's job is only to remember it
+// (established from the OEM capture, 2026-08-17).  Zeros mean "we hold
+// nothing", which reads as stale for every group and asks for a full push.
+inline void flaxGroupCrcList(nlohmann::json::array_t& out)
+{
+    uint64_t cpu = 0;
+    uint64_t pcie = 0;
+    uint64_t dimm = 0;
+
+    std::ifstream in(flaxGroupCrcFile);
+    if (in)
+    {
+        nlohmann::json stored = nlohmann::json::parse(in, nullptr, false);
+        if (!stored.is_discarded() && stored.is_object())
+        {
+            cpu = stored.value("CPU", uint64_t{0});
+            pcie = stored.value("PCIE", uint64_t{0});
+            dimm = stored.value("DIMM", uint64_t{0});
+        }
+    }
+
+    // Order and one-key-per-object shape both copied from the OEM body.
+    nlohmann::json::object_t cpuEntry;
+    cpuEntry["CPU"] = cpu;
+    nlohmann::json::object_t pcieEntry;
+    pcieEntry["PCIE"] = pcie;
+    nlohmann::json::object_t dimmEntry;
+    dimmEntry["DIMM"] = dimm;
+    out.emplace_back(std::move(cpuEntry));
+    out.emplace_back(std::move(pcieEntry));
+    out.emplace_back(std::move(dimmEntry));
+}
